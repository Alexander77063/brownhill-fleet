# hosted/bootstrap/operator-secrets.example
#
# Template for the six secrets the operator owns on a deployed Brownhill Pulsar,
# and for the optional HMRC file beside them.
# Copy to /etc/brownhill/secrets/ on the target host and remove the .example
# suffix; install.sh and the systemd units will read these env files.
#
# If these files are absent at install time, install.sh generates new values with
# `openssl rand -hex` and prints them once to the journal. Production operators
# commonly prefer pre-generated values from their secret manager.

# /etc/brownhill/secrets/pg.env
PG_SUPERUSER_PASSWORD=REPLACE_WITH_64_HEX_CHARACTERS

# /etc/brownhill/secrets/jwt.env — same value on the Next app and PostgREST.
JWT_SHARED_SECRET=REPLACE_WITH_128_HEX_CHARACTERS

# /etc/brownhill/secrets/bootstrap.env — used exactly once for the first-run
# /api/v1/bootstrap endpoint. After the owner account is created, this file is
# still kept (rotation is not in v1 scope) but the endpoint rejects all further
# requests because app_state.bootstrap_pending flips to '0'.
BOOTSTRAP_TOKEN=REPLACE_WITH_64_HEX_CHARACTERS

# /etc/brownhill/secrets/cron.env — the token the scheduled jobs present.
#
# The application's cron routes are exempt from the session middleware, because
# a scheduled call carries a bearer token and no cookie. That leaves
# `isCronAuthorized` (src/lib/cron.ts) as the only thing in front of the job
# that raises invoices — and it fails closed: with CRON_SECRET unset, and
# NODE_ENV=production as the unit sets it, every /api/cron/* call answers 401.
#
# The same value must be in the app's own environment (the app verifies the
# header against it) and in the timer's environment (the timer presents it).
# Both read this one file, so there is only ever one value.
CRON_SECRET=REPLACE_WITH_64_HEX_CHARACTERS

# /etc/brownhill/secrets/backup.env — where the nightly dump is copied to.
#
# The three B2 settings are the operator's to supply — they cannot be
# generated. Until they are filled in the dump still lands on the box every
# night; only the copy OFF the box is skipped, and the box says so in
# /admin/status and in the journal.
BACKBLAZE_B2_KEY_ID=REPLACE_WITH_B2_KEY_ID
BACKBLAZE_B2_APPLICATION_KEY=REPLACE_WITH_B2_APPLICATION_KEY
BACKBLAZE_B2_BUCKET=brownhill-fleet-prod
# Path prefix inside the bucket. The operator FQDN, lowercased, is the canonical choice.
# This is also where the deployment's own address comes from: app.env carries
# NEXT_PUBLIC_APP_URL, built from this value.
BROWNHILL_FQDN=brownhill.example.co.uk

# Where the copy goes. Leave BOTH of these empty and the dump is copied to
# Backblaze B2 — where every box has always copied.
#
# Set BROWNHILL_OFFHOST_DIR to a mounted drive, a NAS share or a second disk
# and the dump is copied there instead, under brownhill/<hostname>/, and every
# file is compared with the dump afterwards — a copy that lost a file on the
# way is reported as a failure, not as a success.
#
# Set BROWNHILL_OFFHOST_TARGET to `b2` or `directory` to choose outright
# rather than let the two settings above decide.
BROWNHILL_OFFHOST_TARGET=
BROWNHILL_OFFHOST_DIR=

# /etc/brownhill/secrets/mtd.env — HMRC Making Tax Digital.
#
# The client id and secret come from HMRC's own registration of this
# deployment (developer.service.hmrc.gov.uk), so they cannot be generated and
# are the operator's to fill in. install.sh creates this file with empty
# values and never overwrites what is in it.
#
# The application reads these names exactly. An empty value means "not
# configured": the HMRC settings page says so, and the rest of the accounting
# module keeps working.
#
#   HMRC_MTD_CLIENT_ID     — the HMRC application's client id.
#   HMRC_MTD_CLIENT_SECRET — its client secret.
#   HMRC_MTD_REDIRECT_URI  — may be left empty: the application then derives
#                            it from the deployment's own address, which is
#                            the same URL. Set it only if HMRC's registration
#                            names a different one.
#   HMRC_ENV               — 'sandbox' while testing, 'production' for live
#                            filings.
#   HMRC_MTD_VRN           — the VAT registration number a return is filed
#                            against (HMRC files one at
#                            POST /organisations/vat/{vrn}/returns). It is
#                            the installation's DEFAULT: the first tenant to
#                            connect to HMRC adopts it, by saving it on the
#                            MTD page, and no other tenant can take it
#                            afterwards — a VAT registration number belongs
#                            to one organisation. A return is always filed
#                            under the tenant's own number. Empty means "not
#                            set": the application then refuses to file
#                            rather than filing against the wrong
#                            organisation.
#   HMRC_MTD_BASE_URL      — the HMRC endpoint. Leave it empty: the
#                            application then uses HMRC's own sandbox or
#                            production address, per HMRC_ENV. The chaos
#                            drills set it, briefly, to point the deployed
#                            application at a stub.
HMRC_MTD_CLIENT_ID=
HMRC_MTD_CLIENT_SECRET=
HMRC_MTD_REDIRECT_URI=
HMRC_ENV=sandbox
HMRC_MTD_VRN=
HMRC_MTD_BASE_URL=
