[Unit]
Description=Brownhill PostgREST 12.2.3
After=postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=postgrest
Group=postgrest
EnvironmentFile=/etc/brownhill/secrets/jwt.env
ExecStart=/opt/brownhill/bin/postgrest /etc/brownhill/postgrest.conf
Restart=on-failure
RestartSec=5
RestartPreventExitStatus=2
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target
