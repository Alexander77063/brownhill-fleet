# ── Supabase ────────────────────────────────────────────────────────────────
# Local values are printed by `pnpm db:start`. Production values come from the
# Supabase dashboard (Project Settings → API).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key

# Direct Postgres connection (used by RLS tests). Default local Supabase DB.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Public base URL of the app. Used for sign links, e-mail CTAs, and Stripe
# redirect URLs. Local: http://localhost:3000. Production: your Vercel domain.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Payments (Phase 2) ──────────────────────────────────────────────────────
GOCARDLESS_ACCESS_TOKEN=
GOCARDLESS_WEBHOOK_SECRET=
GOCARDLESS_ENVIRONMENT=sandbox
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Nigerian subscription collection (NG-2) — PLATFORM keys: tenants paying us.
# Paystack signs webhooks with the same secret key. Flutterwave's webhook "secret
# hash" is a value you choose in its dashboard; it must differ from the API key.
# Webhooks are optional (verify-on-return + the daily reconciliation do the same
# job); Paystack allows one webhook URL per account.
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_HASH=
# SaaS subscription price IDs (Stripe Dashboard → Products). One per plan tier.
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_SCALE=

# ── Cron protection (Vercel Cron / manual triggers) ─────────────────────────
# If set, /api/cron/* requires "Authorization: Bearer ${CRON_SECRET}".
CRON_SECRET=

# ── Notifications (Phase 5) ─────────────────────────────────────────────────
TERMII_API_KEY=
TERMII_SENDER_ID=EliteFleet
RESEND_API_KEY=
NOTIFY_FROM_EMAIL="Elite Fleet Management <fleet@elitefleetmanagement.co.uk>"

# ── Platform AI copilot (Phase 4, dormant until a key is set) ────────────────
# The /platform copilot + the plan-included tenant assistant run on ONE provider,
# selected by AI_PROVIDER (default 'anthropic'). Hand-rolled fetch, no SDK.
#   anthropic        → Anthropic Messages API
#   minimax / openai → OpenAI-compatible Chat Completions
# Key: AI_API_KEY (for 'anthropic' the legacy ANTHROPIC_API_KEY still works). Override
# the endpoint/model with AI_BASE_URL / AI_MODEL. Switching provider is env-only.
#
# Run the platform AI on MiniMax:
#   AI_PROVIDER=minimax   AI_API_KEY=<minimax key>   AI_MODEL=MiniMax-M2
AI_PROVIDER=anthropic
AI_API_KEY=
ANTHROPIC_API_KEY=
AI_GATEWAY_API_KEY=
AI_BASE_URL=
AI_MODEL=claude-sonnet-5

# ── Per-tenant AI assistant (0035) ──────────────────────────────────────────
# Master key that encrypts each tenant's BYO API key at rest (AES-256-GCM).
# 32 bytes, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Dormant until set: the tenant assistant reports "not available" and stores no keys.
TENANT_AI_ENC_KEY=

# ── Vehicle lookup (DVLA Vehicle Enquiry Service, dormant until set) ─────────
# Free API key: https://developer-portal.driver-vehicle-licensing.api.gov.uk/
# Enables "enter registration → auto-fill" on Add vehicle. Manual entry works without it.
DVLA_VES_API_KEY=

# More lookups (all dormant until set)
# Company number -> legal name + registered address (free): developer.company-information.service.gov.uk
COMPANIES_HOUSE_API_KEY=
# Postcode -> address (keyed): getaddress.io
GETADDRESS_API_KEY=
# Driving licence -> categories/endorsements (needs the driver DVLA check code): DVLA Access to Driver Data
DVLA_ADD_API_KEY=

# Cloudflare R2 object storage (S3-compatible). When set, receipts / dashcam
# evidence / insurance certs are stored in R2 instead of Supabase Storage.
# Leave unset to keep using Supabase Storage.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# ── NG-3: hardware tracking gateway (our own Traccar, one per instance) ────────
# Devices report to Traccar by IMEI; Traccar forwards positions and events here
# (forward.url → /api/gps/traccar, event.forward.url → /api/gps/traccar/events)
# with the shared header X-Forward-Secret. Immobilise commands go back through
# the Traccar API with a bearer token. All three unset = hardware features show
# "gateway not configured" and the phone-tracking path is unaffected.
TRACCAR_URL=
TRACCAR_TOKEN=
TRACCAR_FORWARD_SECRET=
